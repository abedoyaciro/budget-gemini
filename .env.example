# Plantilla de variables de entorno
# Copia este archivo como .env y completa con tus credenciales reales
#
#   cp .env.example .env

# ── Credenciales ─────────────────────────────────────────────────────────────

# API Key de Google Gemini AI
# Obtén tu key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Token de autenticación de BudgetBakers Wallet API
# Genera tu token desde la configuración de tu cuenta en BudgetBakers
WALLET_API_TOKEN=tu_token_de_wallet_aqui

# ── Configuración de extracción (opcional) ───────────────────────────────────
# Controlan el comportamiento del extractor sin necesidad de rebuild Docker.

# Número máximo de registros a obtener por extracción (default: 200, máx: 200)
RECORDS_LIMIT=200

# Ventana temporal en días hacia atrás para filtrar registros
# Usa 0 para traer toda la historia disponible (default: 90)
DAYS_BACK=90

# ── Modelos Gemini por servicio (opcional) ────────────────────────────────────
# Cambia el modelo de cada servicio sin tocar código ni hacer rebuild.
# Si no se define una variable específica, se usa GEMINI_MODEL como fallback.
# Si tampoco se define GEMINI_MODEL, cada servicio usa su propio default.
#
# Modelos disponibles (Interactions API + generate_content):
#   gemini-3.1-flash-lite   → Rápido, económico        (recomendado para todos)
#   gemini-3.5-flash        → Balance velocidad/calidad
#   gemini-3.5-pro          → Mayor razonamiento        (recomendado para análisis)
#
# Modelo global (fallback para los tres servicios si no se define el específico):
GEMINI_MODEL=gemini-3.1-flash-lite

# Modelo para análisis financiero (analizador_finanzas.py):
GEMINI_MODEL_ANALIZADOR=gemini-3.1-flash-lite

# Modelo para aprendizaje de reglas (aprendizaje_reglas.py):
GEMINI_MODEL_APRENDIZAJE=gemini-3.1-flash-lite

# Modelo para modificaciones en confirmador (confirmador_reglas.py):
GEMINI_MODEL_CONFIRMADOR=gemini-3.1-flash-lite

# Temperatura global de generación (0.0=determinista, 1.0=creativo, default: 0.3)
GEMINI_TEMPERATURA=0.3

# Máximo de registros a enviar al aprendizaje de reglas (default: 150)
APRENDIZAJE_MAX_REGISTROS=150
