# Plantilla de variables de entorno
#   Copia este archivo como .env y completa el token.
#
#   cp .env.example .env        (o: Copy-Item .env.example .env)

# -- Token REST de BudgetBakers Wallet ---------------------------------------
# Lo usan SOLO las herramientas de tools/ (respaldo, bootstrap, conciliacion).
# Se genera en: https://web.budgetbakers.com/settings/api
# El agente en uso diario NO usa este token: usa OAuth del MCP.
WALLET_API_TOKEN=tu_token_de_wallet_aqui

# -- Nada mas es necesario ---------------------------------------------------
# El MCP de Wallet se autentica por OAuth desde el cliente (ver README).
# No hay claves de IA: el razonamiento lo hace el agente.
