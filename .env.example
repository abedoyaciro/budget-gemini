# Plantilla de variables de entorno
# Copia este archivo como .env y completa con tus credenciales reales
#
#   cp .env.example .env

# -- Credenciales -------------------------------------------------------------

# API Key de Google Gemini AI
# Obtenla en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Token de autenticacion de BudgetBakers Wallet API
# Genera tu token desde la configuracion de tu cuenta en BudgetBakers
WALLET_API_TOKEN=tu_token_de_wallet_aqui

# -- Configuracion de extraccion (opcional) -----------------------------------
#
# DAYS_BACK: ventana temporal en dias hacia atras.
#   90  -> ventana corta (uso semanal normal)
#   0   -> HISTORICO COMPLETO. Ojo: no omite el filtro recordDate, usa un
#          piso de fecha explicito (sin recordDate la API devuelve un subset).
#   Para conciliar cuentas se recomienda 0.
DAYS_BACK=90

# RECORDS_LIMIT: tope TOTAL de registros (no por pagina).
#   0   -> sin tope: se pagina completo y luego se trunca si hiciera falta.
#   >0  -> se pagina completo y se truncan a N registros.
RECORDS_LIMIT=0

# -- Modelos Gemini por servicio (opcional) ------------------------------------
# Si no se define la variable especifica, se usa GEMINI_MODEL como fallback.

# Modelos disponibles (Interactions API + generate_content):
#   gemini-3.1-flash-lite   -> Rapido, economico        (recomendado)
#   gemini-3.5-flash        -> Balance velocidad/calidad
#   gemini-3.5-pro          -> Mayor razonamiento        (recomendado para analisis)

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_ANALIZADOR=gemini-3.1-flash-lite
GEMINI_MODEL_APRENDIZAJE=gemini-3.1-flash-lite
GEMINI_MODEL_CONFIRMADOR=gemini-3.1-flash-lite

# Temperatura global de generacion (0.0=determinista, 1.0=creativo)
GEMINI_TEMPERATURA=0.3

# Maximo de registros a enviar al aprendizaje de reglas
APRENDIZAJE_MAX_REGISTROS=150
